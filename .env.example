# ===== zFrontier 账号（必填）=====
# 完整 Cookie 字符串，从浏览器开发者工具复制。
# 支持整段 "a=1; b=2" 形式，程序会自动解析为键值对。
# 注意：本文件不要提交到 git。
ZF_COOKIE=

# ===== 调度 =====
# 每日运行时间（HH:MM，Asia/Shanghai）
RUN_AT=09:00
# 容器启动时是否立即跑一次
RUN_ON_START=false

# ===== 扫描策略 =====
# 扫描窗口天数：实测最长抽奖周期 14 天
SCAN_WINDOW_DAYS=14
# 安全边距：实测列表最大倒挂 12.3 小时，留 2 天裕量
SCAN_BUFFER_DAYS=2
# 连续 N 条早于边界才停止（实测倒挂最多影响 2 条）
SCAN_CONFIRM_COUNT=10
# 滚动次数硬上限
SCAN_MAX_SCROLL=15
# 条数硬上限
SCAN_MAX_ITEMS=500

# ===== 回复内容 =====
# 语料池，用 | 分隔
REPLY_CORPUS=冲冲冲|来了来了|参与一下|祝我好运|抽我抽我|蹲一个|支持支持|希望能中

# ===== 频率控制 =====
# 请求间隔（秒）
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5
# 单轮写操作上限（关注+回复+点赞）
MAX_WRITE_PER_RUN=30
# 单帖最大重试次数
MAX_RETRY=3

# ===== 依赖服务 =====
SELENIUM_URL=http://bili-selenium:4444

# ===== 存储 =====
DB_PATH=/app/data/zf_lucky.db
PANEL_PORT=8080

# ===== 时区 =====
TZ=Asia/Shanghai
